# Owner-only Telegram Bot Configuration Template
# This repository is source-available for portfolio review, not public self-hosting.
# Using this template does not grant permission to deploy a copy of the bot.
#
# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
BOT_TOKEN=your_token_here_from_botfather

# Режим уведомлений по умолчанию: 'hourly' или 'discount'
DEFAULT_NOTIFY_MODE=discount

# ID администраторов бота (через запятую)
ADMIN_IDS=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Путь к файлу базы данных
DATABASE_PATH=trendyol_bot.db

# --- Optional runtime tuning ---
# How often scheduler runs full check (minutes)
CHECK_ALL_INTERVAL_MINUTES=60
# Concurrent network fetches in check_all
CHECK_ALL_FETCH_CONCURRENCY=10
# Batch sizes for DB iteration/task scheduling
CHECK_ALL_TASK_BATCH_SIZE=200
CHECK_ALL_DB_BATCH_SIZE=1000

# --- Optional backup policy ---
# Keep only latest N database backups
DB_BACKUP_KEEP_FILES=7
# Daily backup schedule (24h format)
DB_BACKUP_HOUR=3
DB_BACKUP_MINUTE=0
